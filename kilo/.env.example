# kilo/.env.example
# Copy to .env and adjust. All values are optional; sensible defaults are built in.

# Kilo/OpenCode HTTP server base URL (where Kilo sends requests).
# Defaults to http://54.219.166.226:4096
KILO_SERVER_URL=http://54.219.166.226:4096

# HTTP basic auth for the server (username defaults to "opencode").
# KILO_SERVER_PASSWORD=your-password
# KILO_SERVER_USERNAME=opencode

# Default agent + model used when creating sessions.
# Uses the server's native `kilo` agent with a free Google model so Kilo runs
# without paid credits. Override with KILO_MODEL / KILO_PROVIDER (e.g.
# KILO_MODEL=kilo-auto/balanced KILO_PROVIDER=kilo if you have credits).
KILO_AGENT=kilo
KILO_MODEL=gemini-2.5-flash
KILO_PROVIDER=google

# Lightweight live viewer (plan + progress over SSE, no browser/ffmpeg).
KILO_VIDEO_PORT=8088

# When launching the server itself via kilo/serve.sh:
# KILO_SERVER_HOST=0.0.0.0
# KILO_SERVER_PORT=4096
# OPENCODE_SERVER_PASSWORD=your-password
# KILO_CORS=http://localhost:5173 https://your-app.example.com
