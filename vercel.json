{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/$1" },
    { "src": "/", "dest": "/index.html" }
  ],
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist"
}
